# Optional public base URL used for canonical tags, sitemap.xml, robots.txt, and OpenGraph cards
# Example: https://jelly-photobooth.vercel.app
APP_URL=
NEXT_PUBLIC_SITE_URL=

# Optional external WebSocket server URL for Remote Duo when frontend is hosted on a serverless platform (e.g. Vercel)
# Example: wss://your-duo-ws-server.onrender.com/api/duo-ws
NEXT_PUBLIC_DUO_WS_URL=

# Optional: set WS_ONLY=true when running server.ts purely as a standalone Remote Duo WebSocket server
WS_ONLY=

